@model RegisterDoctorViewModel
@{
    ViewData["Title"] = "Register as a doctor";
}

<h1>Register as a doctor</h1>
<p>Your account will be reviewed by the clinic admin before you can use the doctor pages.</p>

<form class="mc-form" asp-action="RegisterDoctor" method="post">
    <div class="mc-alert mc-alert--error" asp-validation-summary="ModelOnly"></div>

    <div class="mc-field">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" />
        <span class="mc-field-error" asp-validation-for="FullName"></span>
    </div>

    <div class="mc-field">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="username" />
        <span class="mc-field-error" asp-validation-for="Email"></span>
    </div>

    <div class="mc-field">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" />
        <span class="mc-field-error" asp-validation-for="PhoneNumber"></span>
    </div>

    <div class="mc-field">
        <label asp-for="SpecializationId"></label>
        <select asp-for="SpecializationId" asp-items="SpecializationList.GetItems()">
            <option value="0">Select</option>
        </select>
        <span class="mc-field-error" asp-validation-for="SpecializationId"></span>
    </div>

    <div class="mc-field">
        <label asp-for="LicenseNumber"></label>
        <input asp-for="LicenseNumber" />
        <span class="mc-field-error" asp-validation-for="LicenseNumber"></span>
    </div>

    <div class="mc-field">
        <label asp-for="ConsultationFee"></label>
        <input asp-for="ConsultationFee" />
        <span class="mc-field-error" asp-validation-for="ConsultationFee"></span>
    </div>

    <div class="mc-field">
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="new-password" />
        <span class="mc-field-hint">At least 6 characters with an uppercase letter, a lowercase letter, a digit and a symbol.</span>
        <span class="mc-field-error" asp-validation-for="Password"></span>
    </div>

    <div class="mc-field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span class="mc-field-error" asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="mc-btn">Register</button>
</form>

<p>Already have an account? <a asp-action="Login">Login</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}