@model MediCare.Web.Models.EditScheduleViewModel
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Edit Clinic Hours";
    var slotOptions = new[] { 15, 20, 30, 45, 60 };
}

<div class="mc-page">
    <div class="mc-page-header">
        <div>
            <h1 class="mc-page-title">Consultation &amp; Availability Settings</h1>
            <p class="mc-muted">Set your slot duration and weekly active days.</p>
        </div>
    </div>

    <div class="mc-card mc-edit-card">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="SlotLengthMinutes" class="form-label mc-label"></label>
                    <select asp-for="SlotLengthMinutes" class="form-select">
                        @foreach (var minutes in slotOptions)
                        {
                            <option value="@minutes">@minutes minutes</option>
                        }
                    </select>
                    <span asp-validation-for="SlotLengthMinutes" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StartTime" class="form-label mc-label"></label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EndTime" class="form-label mc-label"></label>
                    <input asp-for="EndTime" type="time" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label mc-label">Working Days Schedule</label>
                <div class="mc-day-pills">
                    @for (var i = 0; i < Model.Days.Count; i++)
                    {
                        <span class="mc-day">
                            <input type="hidden" asp-for="Days[i].DayOfWeek" />
                            <input type="hidden" asp-for="Days[i].DayName" />
                            <input class="mc-day-check" type="checkbox" asp-for="Days[i].IsWorking" id="day_@i" />
                            <label class="mc-day-pill" for="day_@i">@Model.Days[i].DayName</label>
                        </span>
                    }
                </div>
            </div>

            <div class="mc-edit-actions">
                <a class="btn mc-btn-secondary" asp-action="Index">Discard Changes</a>
                <button type="submit" class="btn mc-btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}