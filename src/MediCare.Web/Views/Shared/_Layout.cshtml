@using System.Security.Claims
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    string role = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="mc-header">
        <nav class="mc-nav">
            <a class="mc-nav-link" asp-controller="Home" asp-action="Index">MediCare</a>

            @if (isAuthenticated)
            {
                <a class="mc-nav-link" asp-controller="Home" asp-action="Dashboard">Dashboard</a>

                <form class="mc-logout-form" asp-controller="Account" asp-action="Logout" method="post">
                    <span class="mc-user-name">@User.Identity?.Name (@role)</span>
                    <button type="submit" class="mc-btn">Logout</button>
                </form>
            }
            else
            {
                <a class="mc-nav-link" asp-controller="Account" asp-action="Login">Login</a>
                <a class="mc-nav-link" asp-controller="Account" asp-action="RegisterPatient">Register as patient</a>
                <a class="mc-nav-link" asp-controller="Account" asp-action="RegisterDoctor">Register as doctor</a>
            }
        </nav>
    </header>

    <main class="mc-main container">
        @RenderBody()
    </main>

    <footer class="mc-footer container">
        <span>MediCare</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>